{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        },
        "gpt-5.5": {
          "name": "GPT 5.5"
        },
        "gpt-5.5-pro": {
          "name": "GPT 5.5 Pro"
        },
        "gpt-5.4": {
          "name": "GPT 5.4"
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini"
        },
        "gpt-5.4-nano": {
          "name": "GPT 5.4 Nano"
        },
        "gpt-5.3-codex-spark": {
          "name": "GPT-5.3 Codex Spark"
        },
        "gpt-5.4-mini-fast": {
          "name": "GPT 5.4 Mini Fast"
        }
      }
    },
    "cohere": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cohere",
      "options": {
        "baseURL": "https://api.cohere.ai/compatibility/v1",
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "models": {
        "north-mini-code-1-0": {
          "name": "North Mini Code"
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf /home/*": "deny",
      "git push *": "deny",
      "git send-pack *": "deny",
      "git http-push *": "deny",
      "gh *": "deny",
      "ssh git@github.com *": "deny",
      "ssh *github.com*": "deny"
    }
  }
}
